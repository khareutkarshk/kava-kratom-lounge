---
/**
 * Art-directed responsive image for venue photography.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';

interface Props {
	src: ImageMetadata;
	mobileSrc?: ImageMetadata;
	alt: string;
	class?: string;
	widths?: number[];
	sizes?: string;
	aspectRatio?: string;
	mobileAspectRatio?: string;
	objectPosition?: string;
	mobileObjectPosition?: string;
	loading?: 'eager' | 'lazy';
	fetchpriority?: 'high' | 'low' | 'auto';
	quality?: number;
}

const {
	src,
	mobileSrc,
	alt,
	class: className,
	widths = [640, 960, 1280, 1600, 1920],
	sizes = '100vw',
	aspectRatio,
	mobileAspectRatio,
	objectPosition = 'center',
	mobileObjectPosition,
	loading = 'lazy',
	fetchpriority = 'auto',
	quality = 80,
} = Astro.props;

const desktopAvif = await getImage({ src, widths, format: 'avif', quality });
const desktopWebp = await getImage({ src, widths, format: 'webp', quality });

const mobileAvif = mobileSrc
	? await getImage({ src: mobileSrc, widths: [390, 640, 960], format: 'avif', quality })
	: null;
const mobileWebp = mobileSrc
	? await getImage({ src: mobileSrc, widths: [390, 640, 960], format: 'webp', quality })
	: null;

const styleParts = [
	aspectRatio ? `--art-aspect: ${aspectRatio}` : null,
	mobileAspectRatio ? `--art-aspect-mobile: ${mobileAspectRatio}` : null,
	`--art-pos: ${objectPosition}`,
	mobileObjectPosition ? `--art-pos-mobile: ${mobileObjectPosition}` : null,
].filter(Boolean);
---

<picture class:list={['art-image', className]} style={styleParts.join('; ')}>
	{
		mobileAvif && mobileWebp && (
			<>
				<source
					media="(max-width: 767px)"
					srcset={mobileAvif.srcSet.attribute}
					sizes={sizes}
					type="image/avif"
				/>
				<source
					media="(max-width: 767px)"
					srcset={mobileWebp.srcSet.attribute}
					sizes={sizes}
					type="image/webp"
				/>
			</>
		)
	}
	<source srcset={desktopAvif.srcSet.attribute} sizes={sizes} type="image/avif" />
	<source srcset={desktopWebp.srcSet.attribute} sizes={sizes} type="image/webp" />
	<img
		src={desktopWebp.src}
		srcset={desktopWebp.srcSet.attribute}
		sizes={sizes}
		alt={alt}
		width={desktopWebp.attributes.width}
		height={desktopWebp.attributes.height}
		loading={loading}
		decoding="async"
		fetchpriority={fetchpriority}
		class="art-image__img"
	/>
</picture>

<style>
	.art-image {
		display: block;
		overflow: hidden;
		width: 100%;
		height: 100%;
	}

	.art-image__img {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
		object-position: var(--art-pos, center);
		aspect-ratio: var(--art-aspect, auto);
		transition: filter 0.45s ease;
	}

	.art-image__img:hover {
		filter: brightness(1.06);
	}

	@media (max-width: 767px) {
		.art-image__img {
			object-position: var(--art-pos-mobile, var(--art-pos, center));
			aspect-ratio: var(--art-aspect-mobile, var(--art-aspect, auto));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.art-image__img {
			transition: none;
		}
	}
</style>
