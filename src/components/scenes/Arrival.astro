---
import ArtImage from '../media/ArtImage.astro';
import site from '../../data/site';
import exteriorDesktop from '../../assets/images/exterior-desktop.webp';
import exteriorMobile from '../../assets/images/exterior-mobile.webp';

const { arrival } = site.scenes;
---

<section id={arrival.id} class="arrival" aria-label={site.brand.nameDisplay} x-data>
	<h1 class="sr-only">
		{site.brand.name} — {site.brand.descriptor} in {site.location.display}
	</h1>
	<div class="arrival__media">
		<ArtImage
			src={exteriorDesktop}
			mobileSrc={exteriorMobile}
			alt="Gothic castle-inspired entrance of The Batcave at night"
			class="arrival__img"
			aspectRatio="16 / 9"
			mobileAspectRatio="9 / 16"
			objectPosition="center 40%"
			mobileObjectPosition="center 35%"
			loading="eager"
			fetchpriority="high"
			sizes="100vw"
			widths={[640, 960, 1280, 1600, 1920]}
		/>
		<div class="arrival__vignette" aria-hidden="true"></div>

		<div class="arrival__intro">
			<p class="arrival__intro-place">{site.location.display}</p>
			<p class="arrival__intro-name" aria-hidden="true">{site.brand.nameDisplay}</p>
			<p class="arrival__intro-tag">{site.brand.descriptorDisplay}</p>
			<a class="arrival__intro-cue" href={`#${site.scenes.threshold.id}`}>
				<span class="arrival__intro-cue-text">Scroll</span>
				<span class="arrival__intro-cue-chevron" aria-hidden="true"></span>
			</a>
		</div>
	</div>

	<div class="arrival__content">
		<aside class="arrival__featuring" aria-label="Featuring">
			<div class="arrival__featuring-inner">
				<span class="arrival__featuring-corner arrival__featuring-corner--tl" aria-hidden="true"></span>
				<span class="arrival__featuring-corner arrival__featuring-corner--br" aria-hidden="true"></span>
				<p class="arrival__featuring-label neon-flicker">
					<span class="arrival__featuring-label-mark" aria-hidden="true"></span>
					{arrival.featuringLabel}
				</p>
				<ul class="arrival__featuring-list">
					{
						site.featuring.map((item, i) => (
							<li
								class="reveal"
								style={`transition-delay: ${i * 70}ms`}
								x-intersect.once="$el.classList.add('is-visible')"
							>
								<span class="arrival__featuring-index" aria-hidden="true">
									{String(i + 1).padStart(2, '0')}
								</span>
								<span class="arrival__featuring-item">{item}</span>
							</li>
						))
					}
				</ul>
			</div>
		</aside>
	</div>
</section>

<style>
	/* Featuring / intro styles live in global.css — scoped HMR was dropping updates. */
	.arrival {
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		overflow: clip;
		background: var(--color-void);
	}

	.arrival__media {
		position: relative;
		z-index: 0;
		width: 100%;
		height: 100dvh;
		min-height: 100dvh;
		flex-shrink: 0;
		overflow: hidden;
	}

	.arrival__img {
		height: 100%;
		min-height: 100dvh;
	}

	.arrival__vignette {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}

	.arrival__content {
		position: relative;
		z-index: 1;
		display: flex;
		flex-direction: column;
		justify-content: flex-start;
		min-height: 0;
		padding: 1.75rem 1.25rem 2.75rem;
		background: var(--color-void);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	@media (min-width: 768px) {
		.arrival {
			min-height: 100dvh;
			display: block;
			overflow: hidden;
		}

		.arrival__media {
			position: absolute;
			inset: 0;
			height: auto;
			min-height: 0;
			flex-shrink: unset;
		}

		.arrival__content {
			display: flex;
			flex-direction: row;
			justify-content: flex-end;
			align-items: center;
			min-height: 100dvh;
			padding: 6rem 3.5rem 3.5rem 3rem;
			background: transparent;
			pointer-events: none;
		}

		.arrival__content > * {
			pointer-events: auto;
		}
	}
</style>
